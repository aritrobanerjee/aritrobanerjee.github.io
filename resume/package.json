{
  "name": "markdown-harvard-resume",
  "version": "1.0.0",
  "description": "Zero-dependency Markdown to 1-page Harvard format resume builder (OpenXML .docx + headless browser .pdf)",
  "main": "export.js",
  "type": "module",
  "bin": {
    "harvard-resume": "./export.js"
  },
  "scripts": {
    "start": "node export.js",
    "build": "node export.js",
    "preview": "node export.js --preview",
    "build:sample": "node export.js --input=resume.example.md"
  },
  "keywords": [
    "resume",
    "cv",
    "markdown",
    "harvard",
    "docx",
    "pdf",
    "openxml",
    "zero-dependency",
    "ats-friendly",
    "google-docs"
  ],
  "author": "Aritro Banerjee",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
